# Configuração da nuvem (Supabase) do CapacitaTE
# 1. Copie este arquivo para ".env" (o .env não vai para o Git).
# 2. Preencha com os dados do projeto: Supabase > Project Settings > API.
# 3. Dê dois cliques em "atualizar-env.bat" e recarregue o app (Ctrl+F5).

# Project URL, ex.: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Chave pública (publishable / anon key). Nunca use a service_role key aqui.
SUPABASE_ANON_KEY=
